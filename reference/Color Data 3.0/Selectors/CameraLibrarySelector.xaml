<phone:PhoneApplicationPage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
	xmlns:my="clr-namespace:Color_Data_3._0.Controls"
    xmlns:System="clr-namespace:System;assembly=mscorlib"
    xmlns:prism="clr-namespace:Phone7.Fx.Controls;assembly=Phone7.Fx"
    xmlns:support="clr-namespace:Color_Data_3._0.Support"
    xmlns:Microsoft_Advertising_Mobile_UI="clr-namespace:Microsoft.Advertising.Mobile.UI;assembly=Microsoft.Advertising.Mobile.UI"
    x:Class="Color_Data_3._0.Selectors.CameraLibrarySelector"
    SupportedOrientations="Portrait" Orientation="Portrait"
    mc:Ignorable="d" d:DesignHeight="800" d:DesignWidth="480"
    shell:SystemTray.IsVisible="False" >
	<phone:PhoneApplicationPage.Resources>
		<Storyboard x:Name="blinkContinue" RepeatBehavior="3x">
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="ib_finish">
				<EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
				<EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="1"/>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
		<Storyboard x:Name="SB_Tweak" Completed="SB_Tweak_Completed">
			<ColorAnimation x:Name="CA_A1" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="A1"/>
			<ColorAnimation x:Name="CA_A2" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="A2"/>
			<ColorAnimation x:Name="CA_A3" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="A3"/>
			<ColorAnimation x:Name="CA_A4" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="A4"/>
			<ColorAnimation x:Name="CA_A5" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="A5"/>

			<ColorAnimation x:Name="CA_B1" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="B1"/>
			<ColorAnimation x:Name="CA_B2" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="B2"/>
			<ColorAnimation x:Name="CA_B3" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="B3"/>
			<ColorAnimation x:Name="CA_B4" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="B4"/>
			<ColorAnimation x:Name="CA_B5" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="B5"/>

			<ColorAnimation x:Name="CA_C1" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="C1"/>
			<ColorAnimation x:Name="CA_C2" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="C2"/>
			<ColorAnimation x:Name="CA_C3" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="C3"/>
			<ColorAnimation x:Name="CA_C4" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="C4"/>
			<ColorAnimation x:Name="CA_C5" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="C5"/>

			<ColorAnimation x:Name="CA_D1" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="D1"/>
			<ColorAnimation x:Name="CA_D2" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="D2"/>
			<ColorAnimation x:Name="CA_D3" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="D3"/>
			<ColorAnimation x:Name="CA_D4" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="D4"/>
			<ColorAnimation x:Name="CA_D5" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="D5"/>

			<ColorAnimation x:Name="CA_E1" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="E1"/>
			<ColorAnimation x:Name="CA_E2" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="E2"/>
			<ColorAnimation x:Name="CA_E3" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="E3"/>
			<ColorAnimation x:Name="CA_E4" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="E4"/>
			<ColorAnimation x:Name="CA_E5" Duration="0:0:0.8" To="#FF290804" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="E5"/>

			<DoubleAnimation x:Name="DA_TL1" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_top_L1"/>
			<DoubleAnimation x:Name="DA_TL2" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_top_L2"/>
			<DoubleAnimation x:Name="DA_LL1" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_left_L1"/>
			<DoubleAnimation x:Name="DA_LL2" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_left_L2"/>
			<DoubleAnimation x:Name="DA_BL1" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_bottom_L1"/>
			<DoubleAnimation x:Name="DA_BL2" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_bottom_L2"/>
			<DoubleAnimation x:Name="DA_RL1" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_right_L1"/>
			<DoubleAnimation x:Name="DA_RL2" Duration="0:0:0.8" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="p_right_L2"/>
		</Storyboard>
		<Storyboard x:Name="TweakSelectionHighlight" RepeatBehavior="Forever">
			<DoubleAnimation Duration="0:0:1" To="8" Storyboard.TargetProperty="(Shape.StrokeDashOffset)" d:IsOptimized="True"/>
		</Storyboard>
		<Storyboard x:Name="updateCurrentColor" Completed="updateCurrentColor_Completed">
			<ColorAnimation x:Name="CA_CurrentColor" Duration="0:0:1" To="#FF233683" Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)" Storyboard.TargetName="r_tweakCurrent" d:IsOptimized="True"/>
			<DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="r_tweakCurrent">
				<EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="0.5"/>
				<EasingDoubleKeyFrame KeyTime="0:0:1" Value="1"/>
			</DoubleAnimationUsingKeyFrames>
		</Storyboard>
	</phone:PhoneApplicationPage.Resources>

	<phone:PhoneApplicationPage.FontFamily>
		<StaticResource ResourceKey="PhoneFontFamilyNormal"/>
	</phone:PhoneApplicationPage.FontFamily>
	<phone:PhoneApplicationPage.FontSize>
		<StaticResource ResourceKey="PhoneFontSizeNormal"/>
	</phone:PhoneApplicationPage.FontSize>
	<phone:PhoneApplicationPage.Foreground>
		<StaticResource ResourceKey="PhoneForegroundBrush"/>
	</phone:PhoneApplicationPage.Foreground>


	<!--Sample code showing usage of ApplicationBar-->
	<phone:PhoneApplicationPage.ApplicationBar>
		<shell:ApplicationBar IsVisible="False" IsMenuEnabled="False"/>
	</phone:PhoneApplicationPage.ApplicationBar>


	<Grid x:Name="LayoutRoot" >
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="VisualStates">
				<VisualStateGroup.Transitions>
					<VisualTransition GeneratedDuration="0"/>
				</VisualStateGroup.Transitions>
				<VisualState x:Name="SelectionMode">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_Selector">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="TweakMode">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_Tweak">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="AddColorMode">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_addColor">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="AddSetMode">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_addColorSet">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
			<VisualStateGroup x:Name="SelectionStates">
				<VisualStateGroup.Transitions>
					<VisualTransition GeneratedDuration="0:0:0.4">
						<VisualTransition.GeneratedEasingFunction>
							<CircleEase EasingMode="EaseOut"/>
						</VisualTransition.GeneratedEasingFunction>
					</VisualTransition>
				</VisualStateGroup.Transitions>
				<VisualState x:Name="Normal"/>
				<VisualState x:Name="AddLocked">
					<Storyboard>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_sampling" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_sampling">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_header" d:IsOptimized="True"/>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_add" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_add">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="RemoveLocked">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(Control.IsEnabled)" Storyboard.TargetName="ib_removeColor">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>True</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_remove">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_remove" d:IsOptimized="True"/>
						<DoubleAnimation Duration="0" To="80" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="b_add" d:IsOptimized="True"/>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_continue" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_continue">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="RemoveMode">
					<Storyboard>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_sampling" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_sampling">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_continue" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_continue">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_add" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="b_add">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<System:Boolean>False</System:Boolean>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ib_removeColor">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ib_removeBack">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="b_header" d:IsOptimized="True"/>
						<DoubleAnimation Duration="0" To="-85" Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)" Storyboard.TargetName="b_remove" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(FrameworkElement.Margin)" Storyboard.TargetName="sv_colors">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Thickness>0,-80,0,0</Thickness>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
			<VisualStateGroup x:Name="TweakStates">
				<VisualStateGroup.Transitions>
					<VisualTransition GeneratedDuration="0:0:0.3">
						<VisualTransition.GeneratedEasingFunction>
							<ExponentialEase EasingMode="EaseOut"/>
						</VisualTransition.GeneratedEasingFunction>
					</VisualTransition>
				</VisualStateGroup.Transitions>
				<VisualState x:Name="tweakNormal"/>
				<VisualState x:Name="tweakNamedColor">
					<Storyboard>
						<DoubleAnimation Duration="0" To="200" Storyboard.TargetProperty="(FrameworkElement.Width)" Storyboard.TargetName="g_namedColor" d:IsOptimized="True"/>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<Grid x:Name="g_grids">

			<Grid x:Name="g_Selector" Margin="0,0,0,0" Visibility="Collapsed">
				<Grid.RowDefinitions>
					<RowDefinition Height="*"/>
					<RowDefinition Height="140"/>
				</Grid.RowDefinitions>
				<Grid x:Name="g_Canvas" Grid.Row="0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition/>
					</Grid.RowDefinitions>
					<Grid x:Name="g_Picture" Tap="g_Picture_Tap" Background="{x:Null}" Grid.RowSpan="2">
						<Grid.RenderTransform>
							<TransformGroup>
								<ScaleTransform x:Name="i_scale"/>
								<TranslateTransform x:Name="i_translate"/>
							</TransformGroup>
						</Grid.RenderTransform>
						<toolkit:GestureService.GestureListener>
							<toolkit:GestureListener  PinchStarted="GestureListener_PinchStarted" PinchDelta="GestureListener_PinchDelta"
								DragDelta="GestureListener_DragDelta"/>
						</toolkit:GestureService.GestureListener>
						<Image x:Name="i_picture" Stretch="Uniform" CacheMode="BitmapCache" />
						<Grid x:Name="g_Selections"/>
					</Grid>
					<Border x:Name="b_header" BorderBrush="{x:Null}" Margin="0,0,0,0" VerticalAlignment="Top" Background="#50272727" IsHitTestVisible="False" Grid.Row="1">
						<TextBlock x:Name="tb_sampleType"  Margin="5"  Height="30" HorizontalAlignment="Left"  Text="point sampling" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="1" Foreground="White" />
					</Border>
					<Rectangle x:Name="r_overlay" Fill="#50272727" HorizontalAlignment="Right" Height="38" Margin="0,40,0,0" VerticalAlignment="Top" Width="80" Grid.Row="1"/>
					<my:imageButton 
						x:Name="ib_overlay1" 
						HorizontalAlignment="Right" 
						iconDark="/Images/dark/questionmark.png" iconLight="/Images/light/questionmark.png" 
						Width="58" Margin="0,10,10,12" 
						Tap="ib_overlay_Tap" Grid.Row="1" VerticalAlignment="Top" />
					<Grid Grid.Row="1">
						<Border x:Name="b_sampling"
							HorizontalAlignment="Left" VerticalAlignment="Top" 
							Margin="15,55,0,0" CornerRadius="20" Background="#7E000000">
							<Grid Width="160" Height="80">
								<my:imageButton x:Name="ib_areaCapture" 
									Width="68" Height="68" Margin="6,6,6,6"
									HorizontalAlignment="Left" VerticalAlignment="Center" 
									iconLight="/Images/light/area.png"
									iconDark="/Images/dark/area.png"
									Tap="ib_areaCapture_Tap" />
								<my:imageButton x:Name="ib_pointCapture" 
									Width="68" Height="68" Margin="6,6,6,6"
									HorizontalAlignment="Right" VerticalAlignment="Center"
									iconLight="/Images/light/point.png"
									iconDark="/Images/dark/point.png"
									Tap="ib_pointCapture_Tap"
									IsEnabled="False"/>
							</Grid>
						</Border>
						<Border x:Name="b_continue"
							HorizontalAlignment="Right" VerticalAlignment="Bottom" 
							Margin="0,0,15,15" CornerRadius="20" Background="#7E000000" >
							<Grid Width="80" Height="80">
								<my:imageButton x:Name="ib_finish" 
									Width="68" Height="68" Margin="8,8,8,8"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									iconLight="/Images/light/check.png"
									iconDark="/Images/dark/check.png"
									Tap="ib_finish_Tap"/>
							</Grid>
						</Border>
						<Border x:Name="b_add"
							HorizontalAlignment="Left" VerticalAlignment="Bottom" 
							Margin="15,0,0,100" CornerRadius="20" Background="#7E000000" RenderTransformOrigin="0.5,0.5">
							<Border.RenderTransform>
								<CompositeTransform/>
							</Border.RenderTransform>
							<Grid Width="80" Height="80">
								<my:imageButton x:Name="ib_addColor" 
									Width="68" Height="68" Margin="8,8,8,8"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									iconLight="/Images/light/add.png"
									iconDark="/Images/dark/add.png"
									Tap="ib_addColor_Tap"/>
							</Grid>
						</Border>
						<Border x:Name="b_remove"
							HorizontalAlignment="Left" VerticalAlignment="Bottom" 
							Margin="15,0,0,15" CornerRadius="20" Background="#7E000000" RenderTransformOrigin="0.5,0.5">
							<Border.RenderTransform>
								<CompositeTransform/>
							</Border.RenderTransform>
							<Grid Width="80" Height="80">
								<my:imageButton x:Name="ib_removeColor" 
									Width="68" Height="68" Margin="8,8,8,8"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									iconLight="/Images/light/remove.png"
									iconDark="/Images/dark/remove.png"
									Tap="ib_removeColor_Tap" />
								<my:imageButton x:Name="ib_removeBack" 
									Width="68" Height="68" Margin="8,8,8,8"
									HorizontalAlignment="Center" VerticalAlignment="Center"
									iconLight="/Images/light/back.png"
									iconDark="/Images/dark/back.png"
									Tap="ib_removeBack_Tap" Visibility="Collapsed"  />
							</Grid>
						</Border>
					</Grid>
					<Microsoft_Advertising_Mobile_UI:AdControl x:Name="ad1" ApplicationId="test_client" AdUnitId="Image480_80" Height="80" Width="480"/>
				</Grid>
				<ScrollViewer x:Name="sv_colors" Grid.Row="1" 
					HorizontalScrollBarVisibility="Disabled" 
					VerticalScrollBarVisibility="Disabled" Background="Black">
					<Grid x:Name="g_colors" Background="Black" VerticalAlignment="Bottom" Height="140"/>
				</ScrollViewer>
			</Grid>
			<Grid x:Name="g_Tweak" Margin="0,0,0,0" Visibility="Collapsed" >
				<Grid.RowDefinitions>
					<RowDefinition/>
					<RowDefinition Height="400"/>
					<RowDefinition Height="225"/>
				</Grid.RowDefinitions>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="1*"/>
					<ColumnDefinition Width="400"/>
					<ColumnDefinition Width="1*"/>
				</Grid.ColumnDefinitions>
				<Grid Grid.ColumnSpan="3" Margin="0">
					<Rectangle x:Name="r_tweakOriginal" Fill="#FF0A4A5A" StrokeThickness="0" Margin="0,0,0,50" Width="125" HorizontalAlignment="Left" Tap="r_tweakOriginal_Tap"/>
					<Rectangle x:Name="r_tweakCurrent" Fill="#FF385A0A" StrokeThickness="0" Margin="130,0,0,50"/>
					<Rectangle Margin="0" StrokeThickness="0" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" Height="50">
						<Rectangle.Fill>
							<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
								<GradientStop Color="#FF787878"/>
								<GradientStop Color="Black" Offset="0.694"/>
							</LinearGradientBrush>
						</Rectangle.Fill>
