<UserControl x:Class="Color_Data_3._0.Controls.EditSet" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:SampleData="clr-namespace:Color_Data_3._0.SampleData" 
    xmlns:my="clr-namespace:Phone7.Fx.Controls;assembly=Phone7.Fx" 
	xmlns:local="clr-namespace:Color_Data_3._0.Controls" 
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    Height="800" Width="480"
	d:DataContext="{d:DesignData ../SampleData/sampleEditPopup.xaml}">

	<Grid x:Name="LayoutRoot" Background="#EE000000">
		<Grid x:Name="g_addSet">
			<Grid.RowDefinitions>
				<RowDefinition Height="125"/>
				<RowDefinition Height="50"/>
				<RowDefinition Height="Auto" MinHeight="100"/>
			</Grid.RowDefinitions>
			<local:setRect x:Name="sr_setColors" Margin="0" />
			<Rectangle Margin="0" StrokeThickness="0" RenderTransformOrigin="0.5,0.5" Grid.Row="1">
				<Rectangle.Fill>
					<LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
						<GradientStop Color="#FF787878"/>
						<GradientStop Color="Black" Offset="0.694"/>
					</LinearGradientBrush>
				</Rectangle.Fill>
			</Rectangle>
			<StackPanel Margin="0" Grid.Row="2" d:LayoutOverrides="Height">
				<my:WatermarkedTextBox 
					x:Name="tb_addSet_name" 
					Height="72" 
					Watermark="color name"
					Text="{Binding Title, Mode=TwoWay}"
					InputScope="Text"/>
				<my:WatermarkedTextBox 
					x:Name="tb_addSet_description" 
					Watermark="description" 
					TextWrapping="Wrap" 
					Height="208"
					Text="{Binding Description, Mode=TwoWay}"
					InputScope="Text"/>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
