<UserControl 
	x:Name="userControl" 
	x:Class="Color_Data_3._0.Controls.pSlider"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
	d:DesignWidth="76" d:DesignHeight="425" Background="Gray" Foreground="White">

	<Grid x:Name="LayoutRoot" Background="Transparent" MouseMove="LayoutRoot_MouseMove" MouseLeftButtonDown="LayoutRoot_MouseLeftButtonDown" Tap="LayoutRoot_Tap">
		<Grid.RowDefinitions>
			<RowDefinition Height="10"/>
			<RowDefinition/>
			<RowDefinition Height="10"/>
		</Grid.RowDefinitions>
		<Rectangle x:Name="colorBar" Margin="20,6" Width="10" Fill="{Binding Background, ElementName=userControl}" Grid.Row="1"/>
		<Grid x:Name="g_container" Grid.Row="1" Margin="0,0,0,12" Height="393">
			<Grid.RowDefinitions>
				<RowDefinition/>
				<RowDefinition Height="0"/>
				<RowDefinition Height="Auto"/>
			</Grid.RowDefinitions>
			<Grid x:Name="g_thumb" Height="0" VerticalAlignment="Top" Grid.Row="1">
				<Canvas Height="0" VerticalAlignment="Top" HorizontalAlignment="Center">
					<Path Data="M0,0 L1,0 L1.2,0.5 L1,1 L0,1 z" Margin="0" Stretch="Fill" UseLayoutRounding="False" Width="35" RenderTransformOrigin="0.5,0.5" StrokeThickness="0" Fill="{Binding Foreground, ElementName=userControl}" d:LayoutOverrides="VerticalAlignment" HorizontalAlignment="Left" Height="12" Canvas.Left="-39"/>
					<Path Data="M0.3,0.5 L0.5,0 L1.5,0 L1.5,1 L0.5,1 z" Margin="0" Stretch="Fill" UseLayoutRounding="False" Width="35" RenderTransformOrigin="0.5,0.5" StrokeThickness="0" Fill="{Binding Foreground, ElementName=userControl}" d:LayoutOverrides="VerticalAlignment" HorizontalAlignment="Right" Height="12" Canvas.Left="4"/>
				</Canvas>
			</Grid>
			<Rectangle x:Name="r_lifter" Margin="0" Grid.Row="2" Height="368" StrokeThickness="0" Tap="r_lifter_Tap" Fill="Transparent" />
		</Grid>
	</Grid>
</UserControl>
