<UserControl x:Class="Color_Data_3._0.Controls.colorHolder"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:local="clr-namespace:Color_Data_3._0.Controls"
	xmlns:System="clr-namespace:System;assembly=mscorlib" x:Name="userControl" 
	mc:Ignorable="d"
	
	d:DesignWidth="120" d:DesignHeight="120">
	<UserControl.Resources>
		<Storyboard x:Name="sb_delete">
			<DoubleAnimation Duration="0:0:0.2" To="0" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="border" d:IsOptimized="True"/>
			<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.IsHitTestVisible)" Storyboard.TargetName="border">
				<DiscreteObjectKeyFrame KeyTime="0:0:0.2">
					<DiscreteObjectKeyFrame.Value>
						<System:Boolean>False</System:Boolean>
					</DiscreteObjectKeyFrame.Value>
				</DiscreteObjectKeyFrame>
			</ObjectAnimationUsingKeyFrames>
		</Storyboard>
	</UserControl.Resources>
	<Grid>
		<Border BorderThickness="0,0,2,0" Margin="0" Background="{Binding Background, ElementName=userControl}" BorderBrush="Black"/>
		<Border x:Name="border" BorderThickness="0" CornerRadius="10" Background="#80000000" Height="68" Margin="0,-75,0,0" VerticalAlignment="Top" Width="68">
			<local:imageButton 
				x:Name="ib_remove" 
				HorizontalAlignment="Center" 
				VerticalAlignment="Top" 
				Width="68" Height="68" 
				iconDark="/Images/cd_Images/dark_remove.png" 
				iconLight="/Images/cd_Images/light_remove.png"/>
		</Border>
	</Grid>



</UserControl>