<phone:PhoneApplicationPage
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:my="clr-namespace:Color_Data_3._0.Controls" 
	xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:support="clr-namespace:Color_Data_3._0.Support" 
    x:Class="Color_Data_3._0.Data.NamedColorData"
    mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="728"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="Portrait"  Orientation="Portrait"
    shell:SystemTray.IsVisible="False" >

	<phone:PhoneApplicationPage.ApplicationBar>
		<shell:ApplicationBar IsVisible="True">
			<!--<shell:ApplicationBarIconButton Text="edit" IconUri="/Images/light/edit.png" Click="abib_edit_Click" />
			<shell:ApplicationBar.MenuItems>
				<shell:ApplicationBarMenuItem Text="Edit Name"/>
				<shell:ApplicationBarMenuItem Text="Edit Description"/>
			</shell:ApplicationBar.MenuItems>-->
		</shell:ApplicationBar>
	</phone:PhoneApplicationPage.ApplicationBar>

	<Grid x:Name="LayoutRoot">
		<controls:Panorama x:Name="pano" Title="{StaticResource AppName}" 
						   Foreground="White"
						   TitleTemplate="{StaticResource TitleDataTemplate}" SelectionChanged="Panorama_SelectionChanged">
			<controls:Panorama.Background>
				<ImageBrush ImageSource="..\Images\PanoramaBackground.png" />
			</controls:Panorama.Background>
			<controls:PanoramaItem x:Name="pi_color" Header="color name">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Rectangle x:Name="r_color" Grid.Row="0"
							   Width="Auto" Height="Auto"
							   Fill="Yellow" Margin="-12,0,-115,0" />
				</Grid>
			</controls:PanoramaItem>
			<controls:PanoramaItem x:Name="colorValues" Header="color values">
				<Grid Margin="-12,0,0,0">
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="150" MinWidth="12"/>
						<ColumnDefinition Width="48"/>
						<ColumnDefinition Width="Auto"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Rectangle x:Name="r_original_value" 
								Margin="0,0,0,0" 
								Grid.Row="0" Grid.ColumnSpan="4" 
								Height="72"  
								Fill="Yellow" />
					<Rectangle x:Name="r_original_value2" 
						Margin="0,0,27,0" 
						Grid.Row="0" Grid.RowSpan="18" Grid.Column="0" 
						Fill="{Binding Fill, ElementName=r_currentColor}" />
					<TextBlock Grid.Row="1" Grid.ColumnSpan="3" 
							   Text="RGB" FontSize="26.667" FontWeight="Bold"
							   Margin="8,10,0,0" Grid.Column="1"/>
					<TextBlock Grid.Row="2" Grid.Column="1" Text="R:" FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="3" Grid.Column="1" Text="G:" FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="4" Grid.Column="1" Text="B:"  FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>

					<TextBlock x:Name="tb_value_R" Grid.Row="2" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_G" Grid.Row="3" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_B" Grid.Row="4" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>

					<TextBlock Grid.Row="2" Grid.Column="3" Text="(0-255)"  FontSize="18.667" />
					<TextBlock Grid.Row="3" Grid.Column="3" Text="(0-255)" FontSize="18.667" />
					<TextBlock Grid.Row="4" Grid.Column="3" Text="(0-255)" FontSize="18.667"  />

					<TextBlock Grid.Row="5" Grid.ColumnSpan="3" 
							   Text="HSL" FontSize="26.667" FontWeight="Bold"
							   Margin="8,5,0,0" Grid.Column="1"/>
					<TextBlock Grid.Row="6" Grid.Column="1" Text="H:" FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="7" Grid.Column="1" Text="S:" FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="8" Grid.Column="1" Text="L:"  FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>

					<TextBlock x:Name="tb_value_H" Grid.Row="6" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_S" Grid.Row="7" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_L" Grid.Row="8" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>

					<TextBlock Grid.Row="6" Grid.Column="3" Text="(0-360)"  FontSize="18.667" />
					<TextBlock Grid.Row="7" Grid.Column="3" Text="(%)" FontSize="18.667" />
					<TextBlock Grid.Row="8" Grid.Column="3" Text="(%)" FontSize="18.667"  />

					<TextBlock Grid.Row="9" Grid.ColumnSpan="3" 
							   Text="CMYK*" FontSize="26.667" FontWeight="Bold"
							   Margin="8,5,0,0" Grid.Column="1"/>
					<TextBlock Grid.Row="10" Grid.Column="1" Text="C:" FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="11" Grid.Column="1" Text="M:" FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="12" Grid.Column="1" Text="Y:"  FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="13" Grid.Column="1" Text="K:"  FontSize="18.667" Margin="8,0,0,0" TextAlignment="Right"/>

					<TextBlock x:Name="tb_value_C" Grid.Row="10" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_M" Grid.Row="11" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_Y" Grid.Row="12" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>
					<TextBlock x:Name="tb_value_K" Grid.Row="13" Grid.Column="2" Text="###" FontSize="18.667" Margin="20,0,20,0"/>

					<TextBlock Grid.Row="10" Grid.Column="3" Text="(%)"  FontSize="18.667" />
					<TextBlock Grid.Row="11" Grid.Column="3" Text="(%)" FontSize="18.667" />
					<TextBlock Grid.Row="12" Grid.Column="3" Text="(%)" FontSize="18.667"  />
					<TextBlock Grid.Row="13" Grid.Column="3" Text="(%)" FontSize="18.667"  />

					<TextBlock Grid.Row="14" Grid.ColumnSpan="3" 
							   Text="Hexadecimal" FontSize="26.667" FontWeight="Bold"
							   Margin="8,5,0,0" Grid.Column="1"/>
					<TextBlock Grid.Row="15" Grid.Column="0" Grid.ColumnSpan="3" Text="Value:" FontSize="18.667" Margin="0,0,20,0" TextAlignment="Right"/>
					<TextBlock Grid.Row="16" Grid.Column="0" Grid.ColumnSpan="3" Text="Websafe:" FontSize="18.667" Margin="0,0,20,0" TextAlignment="Right"/>
					<TextBlock x:Name="tb_value_hex" Grid.Row="15" Grid.Column="3" 
							   Text="#abcdef" FontSize="18.667" Margin="0,0,20,0" d:LayoutOverrides="GridBox"/>
					<TextBlock x:Name="tb_value_websafe" Grid.Row="16" Grid.Column="3" 
							   Text="#abcdef" FontSize="18.667" Margin="0,0,20,0" d:LayoutOverrides="GridBox"/>
					<TextBlock Grid.Row="17" Grid.Column="1" Grid.ColumnSpan="3"
							 Text="* CMYK values are only estimates" FontSize="16" FontStyle="Italic" Foreground="Gray"
							   Margin="8,20,-1,0"/>

				</Grid>
			</controls:PanoramaItem>
			<controls:PanoramaItem x:Name="complement" Header="complement">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="193"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Rectangle x:Name="r_original_complement" 
								Margin="0,0,0,0" 
								Grid.Row="1" Grid.ColumnSpan="2" 
								Height="72"  
								Fill="Yellow" />
					<my:simpleColorButton x:Name="scb_complement"
							    Grid.Row="2" Grid.ColumnSpan="2" 
								Height="200" 
								Margin="0,5,20,5"
								ColorBrush="Orange" Padding="0">
						<toolkit:GestureService.GestureListener>
							<toolkit:GestureListener Tap="GestureListener_Tap"  />
						</toolkit:GestureService.GestureListener>
						<toolkit:ContextMenuService.ContextMenu>
							<toolkit:ContextMenu>
								<toolkit:MenuItem Header="Add To Color List" Click="mi_addColorList_Click"/>
							</toolkit:ContextMenu>
						</toolkit:ContextMenuService.ContextMenu>
					</my:simpleColorButton>
					<StackPanel Grid.Row="3" Grid.Column="0" 
								HorizontalAlignment="Left" 
								VerticalAlignment="Top" 
								Orientation="Vertical" 
								Margin="0,15,0,0">
						<TextBlock Text="RGB " FontSize="28" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_complement_R"   Text="R: ## (0-255)" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_G"   Text="G: ## (0-255)" FontStyle="Italic" FontSize="20"  />
						<TextBlock x:Name="tb_complement_B"   Text="B: ## (0-255)" FontStyle="Italic" FontSize="20" />
					</StackPanel>
					<StackPanel  Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,15,0,0">
						<TextBlock   Text="HSL " FontSize="28" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_complement_H"   Text="H: ## (0-360)" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_S"   Text="S: ## (0-100)" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_L"   Text="L: ## (0-100)" FontStyle="Italic" FontSize="20" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,15,0,0">
						<TextBlock   Text="CMYK*" FontSize="28" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_complement_C"   Text="C:  ## (%)" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_M"   Text="M: ## (%)" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_Y"   Text="Y: ## (%)" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_K"   Text="K: ## (%)" FontStyle="Italic" FontSize="20" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,15,0,0">
						<TextBlock   Text="Hex" FontSize="28" FontWeight="SemiBold"/>
						<TextBlock   Text="value:" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_actual" 
								   Margin="40,0,0,0"
								     
								   Text="#abcdef" 
								   FontStyle="Italic" FontSize="20" />
						<TextBlock   Text="websafe:" FontStyle="Italic" FontSize="20" />
						<TextBlock x:Name="tb_complement_websafe" 
								   Margin="40,0,0,0"
								     
								   Text="#abcdef" 
								   FontStyle="Italic" FontSize="20" />
					</StackPanel>
				</Grid>
			</controls:PanoramaItem>
			<controls:PanoramaItem x:Name="splitComplement" Header="split complement" Orientation="Horizontal" Width="600">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Rectangle x:Name="r_original_splitComplement" 
							   Grid.Row="1" Grid.ColumnSpan="4" 
							   Height="72" 
							   Margin="-15,0,0,0" 
							   Fill="Yellow" />
					<my:simpleColorButton x:Name="scb_splitComplement1"
							    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
								Height="200" 
								Margin="0,5,10,5"
								ColorBrush="Orange" Padding="0" >
						<toolkit:GestureService.GestureListener>
							<toolkit:GestureListener Tap="GestureListener_Tap" />
						</toolkit:GestureService.GestureListener>
						<toolkit:ContextMenuService.ContextMenu>
							<toolkit:ContextMenu>
								<toolkit:MenuItem Header="Add To Color List" Click="mi_addColorList_Click"/>
							</toolkit:ContextMenu>
						</toolkit:ContextMenuService.ContextMenu>
					</my:simpleColorButton>
					<my:simpleColorButton x:Name="scb_splitComplement2"
							    Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" 
								Height="200" 
								Margin="0,5,20,5"
								ColorBrush="Orange" Padding="0" >
						<toolkit:GestureService.GestureListener>
							<toolkit:GestureListener Tap="GestureListener_Tap" />
						</toolkit:GestureService.GestureListener>
						<toolkit:ContextMenuService.ContextMenu>
							<toolkit:ContextMenu>
								<toolkit:MenuItem Header="Add To Color List" Click="mi_addColorList_Click"/>
							</toolkit:ContextMenu>
						</toolkit:ContextMenuService.ContextMenu>
					</my:simpleColorButton>
					<StackPanel Grid.Row="3" Grid.Column="0" 
								HorizontalAlignment="Left" 
								VerticalAlignment="Top" 
								Orientation="Vertical" 
								Margin="0,20,0,0">
						<TextBlock Text="RGB "  FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_splitComplement1_R"   Text="R: ## (0-255)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_G"   Text="G: ## (0-255)" FontStyle="Italic" FontSize="18"  />
						<TextBlock x:Name="tb_splitComplement1_B"   Text="B: ## (0-255)" FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel  Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,20,0,0">
						<TextBlock   Text="HSL " FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_splitComplement1_H"   Text="H: ## (0-360)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_S"   Text="S: ## (0-100)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_L"   Text="L: ## (0-100)" FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,20,0,0">
						<TextBlock   Text="CMYK*" FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_splitComplement1_C"   Text="C:  ## (%)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_M"   Text="M: ## (%)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_Y"   Text="Y: ## (%)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_K"   Text="K: ## (%)" FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="1" 
								HorizontalAlignment="Left" VerticalAlignment="Top" 
								Orientation="Vertical" Margin="0,20,0,0">
						<TextBlock   Text="Hex" FontSize="24" FontWeight="SemiBold"/>
						<TextBlock   Text="value:" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_actual" 
								   Margin="10,0,0,0"
								     
								   Text="#abcdef" 
								   FontStyle="Italic" FontSize="18" />
						<TextBlock   Text="websafe:" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement1_websafe" 
								   Margin="10,0,0,0"
								     
								   Text="#abcdef" 
								   FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel Grid.Row="3" Grid.Column="2" 
								HorizontalAlignment="Left" 
								VerticalAlignment="Top" 
								Orientation="Vertical" 
								Margin="0,20,0,0">
						<TextBlock Text="RGB "  FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_splitComplement2_R"   Text="R: ## (0-255)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_G"   Text="G: ## (0-255)" FontStyle="Italic" FontSize="18"  />
						<TextBlock x:Name="tb_splitComplement2_B"   Text="B: ## (0-255)" FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel  Grid.Row="3" Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,20,0,0">
						<TextBlock   Text="HSL " FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_splitComplement2_H"   Text="H: ## (0-360)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_S"   Text="S: ## (0-100)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_L"   Text="L: ## (0-100)" FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Top" Orientation="Vertical" Margin="0,20,0,0">
						<TextBlock   Text="CMYK*" FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_splitComplement2_C"   Text="C:  ## (%)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_M"   Text="M: ## (%)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_Y"   Text="Y: ## (%)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_K"   Text="K: ## (%)" FontStyle="Italic" FontSize="18" />
					</StackPanel>
					<StackPanel Grid.Row="4" Grid.Column="3" 
								HorizontalAlignment="Left" 
								VerticalAlignment="Top" 
								Orientation="Vertical" 
								Margin="0,20,0,0">
						<TextBlock   Text="Hex" FontSize="24" FontWeight="SemiBold"/>
						<TextBlock   Text="value:" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_actual" 
								   Margin="10,0,0,0"
								     
								   Text="#abcdef" 
								   FontStyle="Italic" FontSize="18" />
						<TextBlock   Text="websafe:" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_splitComplement2_websafe" 
								   Margin="10,0,0,0"
								     
								   Text="#abcdef" 
								   FontStyle="Italic" FontSize="18" />
					</StackPanel>
				</Grid>
			</controls:PanoramaItem>
			<controls:PanoramaItem x:Name="triad" Header="triad" Orientation="Horizontal" Width="600">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Rectangle x:Name="r_original_triad" 
							   Grid.Row="1" Grid.ColumnSpan="4" 
							   Height="72" 
							   Margin="-15,0,0,0" 
							   Fill="Yellow" />
					<my:simpleColorButton x:Name="scb_triad1"
							    Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
								Height="200" 
								Margin="0,5,10,5"
								ColorBrush="Orange" Padding="0" >
						<toolkit:GestureService.GestureListener>
							<toolkit:GestureListener Tap="GestureListener_Tap" />
						</toolkit:GestureService.GestureListener>
						<toolkit:ContextMenuService.ContextMenu>
							<toolkit:ContextMenu>
								<toolkit:MenuItem Header="Add To Color List" Click="mi_addColorList_Click"/>
							</toolkit:ContextMenu>
						</toolkit:ContextMenuService.ContextMenu>
					</my:simpleColorButton>
					<my:simpleColorButton x:Name="scb_triad2"
							    Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" 
								Height="200" 
								Margin="0,5,20,5"
								ColorBrush="Orange" Padding="0" >
						<toolkit:GestureService.GestureListener>
							<toolkit:GestureListener Tap="GestureListener_Tap" />
						</toolkit:GestureService.GestureListener>
						<toolkit:ContextMenuService.ContextMenu>
							<toolkit:ContextMenu>
								<toolkit:MenuItem Header="Add To Color List" Click="mi_addColorList_Click"/>
							</toolkit:ContextMenu>
						</toolkit:ContextMenuService.ContextMenu>
					</my:simpleColorButton>
					<StackPanel Grid.Row="3" Grid.Column="0" 
								HorizontalAlignment="Left" 
								VerticalAlignment="Top" 
								Orientation="Vertical" 
								Margin="0,20,0,0">
						<TextBlock Text="RGB "  FontSize="24" FontWeight="SemiBold"/>
						<TextBlock x:Name="tb_triad1_R"   Text="R: ## (0-255)" FontStyle="Italic" FontSize="18" />
						<TextBlock x:Name="tb_triad1_G"   Text="G: ## (0-255)" FontStyle="Italic" FontSize="18"  />
						<TextBlock x:Name="tb_triad1_B"   Text="B: ## (0-255)" FontStyle="Italic" FontSize="18" />
