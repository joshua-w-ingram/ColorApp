<phone:PhoneApplicationPage 
	x:Class="Color_Data_3._0.Support.Setup"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
	xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone" 
	xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone" 
	xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:my="clr-namespace:Color_Data_3._0.Controls" 
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}" d:DesignHeight="800" d:DesignWidth="480">
	<phone:PhoneApplicationPage.Resources>
		<ControlTemplate x:Key="PhoneDisabledTextBoxTemplate" TargetType="TextBox">
			<ContentControl x:Name="ContentElement" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="{StaticResource PhoneTextBoxInnerMargin}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="Stretch"/>
		</ControlTemplate>
		<Style x:Key="TextBoxStyle1" TargetType="TextBox">
			<Setter Property="FontFamily" Value="{StaticResource PhoneFontFamilyNormal}"/>
			<Setter Property="FontSize" Value="{StaticResource PhoneFontSizeMediumLarge}"/>
			<Setter Property="Background" Value="{StaticResource PhoneTextBoxBrush}"/>
			<Setter Property="Foreground" Value="{StaticResource PhoneTextBoxForegroundBrush}"/>
			<Setter Property="BorderBrush" Value="{StaticResource PhoneTextBoxBrush}"/>
			<Setter Property="SelectionBackground" Value="{StaticResource PhoneAccentBrush}"/>
			<Setter Property="SelectionForeground" Value="{StaticResource PhoneTextBoxSelectionForegroundBrush}"/>
			<Setter Property="BorderThickness" Value="{StaticResource PhoneBorderThickness}"/>
			<Setter Property="Padding" Value="2"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Grid Background="Transparent">
							<VisualStateManager.VisualStateGroups>
								<VisualStateGroup x:Name="CommonStates">
									<VisualState x:Name="Normal"/>
									<VisualState x:Name="MouseOver"/>
									<VisualState x:Name="Disabled">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Storyboard.TargetName="EnabledBorder">
												<DiscreteObjectKeyFrame KeyTime="0">
													<DiscreteObjectKeyFrame.Value>
														<Visibility>Collapsed</Visibility>
													</DiscreteObjectKeyFrame.Value>
												</DiscreteObjectKeyFrame>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DisabledOrReadonlyBorder">
												<DiscreteObjectKeyFrame KeyTime="0">
													<DiscreteObjectKeyFrame.Value>
														<Visibility>Visible</Visibility>
													</DiscreteObjectKeyFrame.Value>
												</DiscreteObjectKeyFrame>
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="ReadOnly">
										<Storyboard>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Storyboard.TargetName="EnabledBorder">
												<DiscreteObjectKeyFrame KeyTime="0">
													<DiscreteObjectKeyFrame.Value>
														<Visibility>Collapsed</Visibility>
													</DiscreteObjectKeyFrame.Value>
												</DiscreteObjectKeyFrame>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DisabledOrReadonlyBorder">
												<DiscreteObjectKeyFrame KeyTime="0">
													<DiscreteObjectKeyFrame.Value>
														<Visibility>Visible</Visibility>
													</DiscreteObjectKeyFrame.Value>
												</DiscreteObjectKeyFrame>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Storyboard.TargetName="DisabledOrReadonlyBorder">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhoneTextBoxBrush}"/>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="BorderBrush" Storyboard.TargetName="DisabledOrReadonlyBorder">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhoneTextBoxBrush}"/>
											</ObjectAnimationUsingKeyFrames>
											<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Foreground" Storyboard.TargetName="DisabledOrReadonlyContent">
												<DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource PhoneTextBoxReadOnlyBrush}"/>
											</ObjectAnimationUsingKeyFrames>
										</Storyboard>
									</VisualState>
								</VisualStateGroup>
								<VisualStateGroup x:Name="FocusStates">
									<VisualState x:Name="Focused">
										<Storyboard>
											<ColorAnimation Duration="0" To="#FF878787" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" Storyboard.TargetName="EnabledBorder" d:IsOptimized="True"/>
											<ColorAnimation Duration="0" To="Black" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" Storyboard.TargetName="EnabledBorder" d:IsOptimized="True"/>
										</Storyboard>
									</VisualState>
									<VisualState x:Name="Unfocused"/>
								</VisualStateGroup>
							</VisualStateManager.VisualStateGroups>
							<Border x:Name="EnabledBorder" BorderThickness="{TemplateBinding BorderThickness}" Margin="{StaticResource PhoneTouchTargetOverhang}" Background="Black" BorderBrush="Black">
								<ContentControl x:Name="ContentElement" BorderThickness="0" HorizontalContentAlignment="Stretch" Margin="{StaticResource PhoneTextBoxInnerMargin}" Padding="{TemplateBinding Padding}" VerticalContentAlignment="Stretch"/>
							</Border>
							<Border x:Name="DisabledOrReadonlyBorder" BorderBrush="{StaticResource PhoneDisabledBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="Transparent" Margin="{StaticResource PhoneTouchTargetOverhang}" Visibility="Collapsed">
								<TextBox x:Name="DisabledOrReadonlyContent" Background="Transparent" Foreground="{StaticResource PhoneDisabledBrush}" FontWeight="{TemplateBinding FontWeight}" FontStyle="{TemplateBinding FontStyle}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" IsReadOnly="True" SelectionForeground="{TemplateBinding SelectionForeground}" SelectionBackground="{TemplateBinding SelectionBackground}" TextAlignment="{TemplateBinding TextAlignment}" TextWrapping="{TemplateBinding TextWrapping}" Text="{TemplateBinding Text}" Template="{StaticResource PhoneDisabledTextBoxTemplate}"/>
							</Border>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</phone:PhoneApplicationPage.Resources>

	<Grid x:Name="LayoutRoot" Background="Black">
		<VisualStateManager.VisualStateGroups>
			<VisualStateGroup x:Name="VisualStateGroup">
				<VisualState x:Name="Start"/>
				<VisualState x:Name="FirstTimer">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_start">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_Veteran">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_firstTimer">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Veteran">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_start">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_firstTimer">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_Veteran">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="VeteranDone">
					<Storyboard>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_VeteranDone">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_start">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_firstTimer">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_Veteran">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
				<VisualState x:Name="Failed">
					<Storyboard>
						<DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="g_failed" d:IsOptimized="True"/>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_failed">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Visible</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_start">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_firstTimer">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_Veteran">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
						<ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="g_VeteranDone">
							<DiscreteObjectKeyFrame KeyTime="0">
								<DiscreteObjectKeyFrame.Value>
									<Visibility>Collapsed</Visibility>
								</DiscreteObjectKeyFrame.Value>
							</DiscreteObjectKeyFrame>
						</ObjectAnimationUsingKeyFrames>
					</Storyboard>
				</VisualState>
			</VisualStateGroup>
		</VisualStateManager.VisualStateGroups>
		<Canvas x:Name="cd_case_design" Height="196" VerticalAlignment="Bottom" Margin="235,0,30,81">
			<Path Data="F1M289.5781,507.8125L288.2761,508.4035L234.4681,555.0005L272.0151,626.6985L273.3151,626.1085L313.7611,575.1655z" Fill="White" Height="639.966" Canvas.Left="-206.854" Stretch="Fill" Canvas.Top="-477.198" Width="426.836" UseLayoutRounding="False"/>
			<Path Data="M213.46899,0 L230.56799,4.8322902 L230.56799,376.64688 L0,281.27902 L0,274.27557 L4.1179261,275.99292 L4.1179261,275.98209 L0,274.27557 z" Fill="White" Height="376.647" Canvas.Left="15.432" Stretch="Fill" Canvas.Top="-99.864" UseLayoutRounding="False" Width="230.568"/>
			<Image Source="/Images/cd_Images/Image.png" Stretch="Fill" Height="619" Canvas.Left="72" Canvas.Top="-123" Width="813">
				<Image.Clip>
					<RectangleGeometry Rect="-370.281,-501.597,600,1191.67"/>
				</Image.Clip>
				<Image.RenderTransform>
					<CompositeTransform ScaleY="0.48" ScaleX="0.48" TranslateX="63.735" TranslateY="80.7666"/>
				</Image.RenderTransform>
			</Image>
		</Canvas>

		<Grid x:Name="g_start" Margin="0">
			<TextBlock TextWrapping="Wrap" Text="Let's get you setup!" VerticalAlignment="Top" FontSize="48" HorizontalAlignment="Left" Width="240" d:LayoutOverrides="HorizontalAlignment" Margin="12,2,0,0"/>
			<TextBlock Margin="138,215,0,0" TextWrapping="Wrap" Text="Is this your first time using Color Data?" VerticalAlignment="Top" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="205"/>
			<TextBlock Margin="138,357,0,390" TextWrapping="Wrap" HorizontalAlignment="Left" FontWeight="Bold" Width="262" d:LayoutOverrides="Height"><Run Foreground="Black" Text="Or, do you have an account code already?"/></TextBlock>
			<Button x:Name="b_firstTime" Content="First Time" VerticalAlignment="Top" Margin="158,272,82,0" BorderBrush="Black" Foreground="Black" Width="240" Tap="b_firstTime_Tap" />
			<Button x:Name="b_Veteran" Content="I Have A Code" Margin="158,0,82,318" BorderBrush="Black" Foreground="Black" Width="240" VerticalAlignment="Bottom" Tap="b_Veteran_Tap" />
			<TextBlock HorizontalAlignment="Left" Margin="12,0,0,190" TextWrapping="Wrap" VerticalAlignment="Bottom" Width="199" FontWeight="Bold"><Span><Run Text="Are you"/></Span><LineBreak/><Run Text=" "/><Span><Run Text="wondering"/></Span><LineBreak/><Run Text=" "/><Span><Run Text="why you"/></Span><LineBreak/><Run Text=" "/><Span><Run Text="need a code"/></Span><LineBreak/><Run Text=" "/><Span><Run Text="just to look at"/></Span><LineBreak/><Run Text=" "/><Span><Run Text="some colors?"/></Span></TextBlock>
			<TextBlock HorizontalAlignment="Left" Margin="15,0,0,11" TextWrapping="Wrap" VerticalAlignment="Bottom" Width="199" Text="Color Data gives you more than just color values. You get access to all of your color information online with your code. "/>

		</Grid>
		<Grid x:Name="g_firstTimer" Margin="0" Visibility="Collapsed">
			<TextBlock TextWrapping="Wrap" Text="That's it." VerticalAlignment="Top" FontSize="48" HorizontalAlignment="Left" Width="240" d:LayoutOverrides="HorizontalAlignment" Margin="12,2,0,0"/>
			<TextBlock Margin="164,195,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="211" Text="After you add colors and sets. They will be automatically synced online"/>
			<TextBlock x:Name="tb_code" Margin="83,311,0,399" TextWrapping="Wrap" Text="######" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" FontSize="64" TextAlignment="Center" Width="335"/>
			<TextBlock Height="127" Margin="44,76,0,0" TextWrapping="Wrap" VerticalAlignment="Top" HorizontalAlignment="Left" Width="189" FontSize="32" Text="Here's your code! "/>
			<Button x:Name="b_emailCode" Content="Email Code" VerticalAlignment="Bottom" Margin="164,0,129,261" BorderBrush="Black" Foreground="Black" Tap="b_emailCode_Tap" />
			<TextBlock Margin="140,0,0,331.207" TextWrapping="Wrap" VerticalAlignment="Bottom" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="211" Text="Email yourself the code for easy access"/>
			<Button x:Name="b_exit1" Content="Done" VerticalAlignment="Bottom" Margin="12,0,0,12" BorderBrush="White" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="200" Tap="b_exit_Tap"/>

		</Grid>
		<Grid x:Name="g_Veteran" Margin="0" Visibility="Collapsed">
			<TextBlock TextWrapping="Wrap" Text="Welcome back!" VerticalAlignment="Top" FontSize="48" HorizontalAlignment="Left" Width="252" Margin="12,2,0,0"/>
			<TextBlock Margin="180,201,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="211" Text="What's your code?"/>
			<TextBox x:Name="tbox_code" Margin="96,260,82,0" VerticalAlignment="Top" FontSize="48" Background="Black" BorderBrush="Black" Foreground="White" SelectionForeground="White" FontWeight="Bold" MaxLength="6" Style="{StaticResource TextBoxStyle1}" InputScope="AlphanumericFullWidth" TextChanged="tbox_code_TextChanged"/>
			<Button x:Name="b_downloadData" Content="Download Data" Margin="152,379,102,349" d:LayoutOverrides="Height" BorderBrush="Black" Foreground="Black" Tap="b_downloadData_Tap" />
			<TextBlock x:Name="tb_invalidCode" Margin="118,349,82,0" TextWrapping="Wrap" Text="*Invalid account code" VerticalAlignment="Top" Foreground="Red" FontSize="16" HorizontalAlignment="Left" Visibility="Collapsed"/>

		</Grid>
		<Grid x:Name="g_VeteranDone" Margin="0" Visibility="Collapsed">
			<TextBlock TextWrapping="Wrap" Text="You're all set!" VerticalAlignment="Top" FontSize="48" HorizontalAlignment="Left" Width="252" Margin="12,2,0,0"/>
			<TextBlock Margin="105,269,0,344" TextWrapping="Wrap" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="302" Text="Your data should be all synced! And because we've improved so many things you may think it looks a little different. We hope so and we hope you like it." d:LayoutOverrides="Height"/>
			<Button x:Name="b_exit2" Content="Done" VerticalAlignment="Bottom" Margin="12,0,0,12" BorderBrush="White" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="200" Tap="b_exit_Tap"/>
		</Grid>
		<Grid x:Name="g_failed" Margin="0" Visibility="Collapsed" Opacity="0">
			<TextBlock TextWrapping="Wrap" Text="Oh no!" VerticalAlignment="Top" FontSize="48" HorizontalAlignment="Left" Width="252" Margin="12,2,0,0"/>
			<TextBlock Margin="159,256,0,0" TextWrapping="Wrap" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="224" Text="Make sure you have internet access during setup." VerticalAlignment="Top" d:LayoutOverrides="VerticalAlignment"/>
			<Button x:Name="b_exit3" Content="Done" VerticalAlignment="Bottom" Margin="12,0,0,12" BorderBrush="White" Foreground="White" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="200" Tap="b_exit_Tap"/>
			<TextBlock Margin="159,357,0,0" TextWrapping="Wrap" Foreground="Black" HorizontalAlignment="Left" FontWeight="Bold" Width="224" Text="You can try again next time you launch Color Data. You can also disable this feature in the settings if you like." VerticalAlignment="Top" Height="144"/>
		</Grid>
		<my:Waiting x:Name="w_waiting" Visibility="Collapsed"/>
	</Grid>
</phone:PhoneApplicationPage>
