		</Popup>
		<my:Waiting x:Name="w_waiting" Visibility="Collapsed" Grid.RowSpan="2"/>
	</Grid>

	<phone:PhoneApplicationPage.ApplicationBar>
		<shell:ApplicationBar IsVisible="False" IsMenuEnabled="True">
			<shell:ApplicationBar.MenuItems>
				<shell:ApplicationBarMenuItem Text="settings" Click="abmi_setting_Click"/>
				<shell:ApplicationBarMenuItem Text="named colors" Click="abmi_namedColors_Click"/>
				<shell:ApplicationBarMenuItem Text="help" Click="abmi_help_Click"/>
			</shell:ApplicationBar.MenuItems>
		</shell:ApplicationBar>
	</phone:PhoneApplicationPage.ApplicationBar>

