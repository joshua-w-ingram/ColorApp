<Application
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
	xmlns:nav="clr-namespace:System.Windows.Navigation;assembly=Microsoft.Phone"
    xmlns:sys="clr-namespace:System;assembly=mscorlib" 
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	xmlns:my="clr-namespace:Color_Data_3._0.Classes"
	xmlns:converter="clr-namespace:Color_Data_3._0.Classes.Converters"
	xmlns:controls="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls" 
	xmlns:controlsPrimitives="clr-namespace:Microsoft.Phone.Controls.Primitives;assembly=Microsoft.Phone.Controls"
	mc:Ignorable="d" 
    x:Class="Color_Data_3._0.App" >

	<!--Application Resources-->
	<Application.Resources>
		<converter:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
		<converter:BoolToBrushConverter x:Key="BoolToBrush"/>
		<my:ApplicationLicense x:Key="LicenseInfo"/>

		<sys:String x:Key="AppName">Color Data 3.0</sys:String>
		<Style x:Key="AppTitleStyle" TargetType="TextBlock">
			<Setter  Property="FontFamily" Value="/Fonts/homesteadregular.ttf#Homestead"/>
			<Setter Property="FontSize" Value="25"/>
			<Setter Property="Foreground" Value="Teal"/>
		</Style>
		<DataTemplate x:Key="TitleDataTemplate">
			<ContentPresenter>
				<TextBlock Text="{Binding}" FontSize="25" Margin="0,80,0,-20" 
						   FontFamily=".\Fonts\homesteadregular.ttf#Homestead" Foreground="Teal" />
			</ContentPresenter>
		</DataTemplate>
		<DataTemplate x:Key="PivotTitleDataTemplate">
			<ContentPresenter>
				<TextBlock Text="{Binding}" FontSize="25" Margin="0" 
						   FontFamily=".\Fonts\homesteadregular.ttf#Homestead" Foreground="Teal" />
			</ContentPresenter>
		</DataTemplate>
		<!--reference
		http://www.windowsphonegeek.com/articles/All-about-UriMapping-in-WP7-->
		<nav:UriMapper x:Key="UriMapper">
			<nav:UriMapping Uri="/Main" MappedUri="/MainPage.xaml" />
			<nav:UriMapping Uri="/CameraLibrary/{selector}" MappedUri="/Selectors/CameraLibrarySelector.xaml?selector={selector}" />
			<nav:UriMapping Uri="/QuickSelector" MappedUri="/Selectors/QuickSelector.xaml" />
			<nav:UriMapping Uri="/ColorData" MappedUri="/Data/ColorData.xaml" />
			<nav:UriMapping Uri="/NamedColorData" MappedUri="/Data/NamedColorData.xaml" />
			<nav:UriMapping Uri="/SetData" MappedUri="/Data/SetData.xaml" />
			<nav:UriMapping Uri="/Arrange" MappedUri="/Data/SetArrangement.xaml" />
			<nav:UriMapping Uri="/Test" MappedUri="/TestPage2.xaml" />
			<nav:UriMapping Uri="/Settings" MappedUri="/Support/Settings.xaml" /> 
			<nav:UriMapping Uri="/Help" MappedUri="/Support/help.xaml" />
			<nav:UriMapping Uri="/Setup" MappedUri="/Support/Setup.xaml" />
		</nav:UriMapper>

		<Style x:Key="pivotOverlays" TargetType="controls:Pivot">
			<Setter Property="Margin" Value="0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Foreground" Value="{StaticResource PhoneForegroundBrush}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="ItemsPanel">
				<Setter.Value>
					<ItemsPanelTemplate>
						<Grid/>
					</ItemsPanelTemplate>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="controls:Pivot">
						<Grid HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}">
							<Grid.RowDefinitions>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="Auto"/>
								<RowDefinition Height="*"/>
							</Grid.RowDefinitions>
							<controlsPrimitives:PivotHeadersControl x:Name="HeadersListElement" Grid.Row="1"/>
							<ItemsPresenter x:Name="PivotItemPresenter" Margin="{TemplateBinding Padding}" Grid.Row="2"/>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Application.Resources>

	<Application.ApplicationLifetimeObjects>
		<!--Required object that handles lifetime events for the application-->
		<shell:PhoneApplicationService 
    		Launching="Application_Launching" Closing="Application_Closing" 
    		Activated="Application_Activated" Deactivated="Application_Deactivated"/>
	</Application.ApplicationLifetimeObjects>

</Application>